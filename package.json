{
  "name": "kbkan",
  "version": "0.1.0",
  "description": "Local markdown kanban CLI and web UI: tickets are plain .md files, the board is kanban.yaml.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "kb": "dist/cli/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "kb_image.png"
  ],
  "keywords": [
    "kanban",
    "cli",
    "markdown",
    "tickets",
    "task-management",
    "local-first"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hampusadamsson/kb.git"
  },
  "homepage": "https://github.com/hampusadamsson/kb#readme",
  "bugs": {
    "url": "https://github.com/hampusadamsson/kb/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && node -e \"fs.cpSync('src/web/public','dist/web/public',{recursive:true})\"",
    "install:local": "npm run build && npm link",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "oxlint src test scripts",
    "lint:fix": "oxlint src test scripts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm test",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run verify",
    "prepare": "husky || true",
    "commitlint": "commitlint --from origin/main --to HEAD --verbose"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{css,html,json,md,yaml,yml}": "prettier --write"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.91.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "volta": {
    "node": "22.20.0"
  }
}
